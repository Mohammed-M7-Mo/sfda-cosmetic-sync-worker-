# بوابة الاستقبال على موقع ووردبريس (بدون شرطة مائلة في النهاية)
WP_SYNC_BASE_URL=https://astc-arabia.com/wp-json/sfda-mirror/v1/sync

# مفاتيح الربط المستخرجة من لوحة تحكم الإضافة
WP_SFDA_API_KEY=sfda_replace_with_your_api_key
WP_SFDA_HMAC_SECRET=replace_with_your_64_char_hmac_secret

# إعدادات السحب والأداء (اختيارية ولها قيم افتراضية آمنة)
SFDA_LISTS_SCOPE=all
SFDA_REQUEST_DELAY_SEC=0.45
SFDA_DETAIL_CONCURRENCY=3
SFDA_HTTP_TIMEOUT_SEC=45
SFDA_MAX_RETRIES=5
SFDA_BATCH_SIZE=100
SFDA_ENABLE_ENRICHMENT=true
SFDA_CHECKPOINT_TTL_HOURS=36
SFDA_STATE_DIR=state
